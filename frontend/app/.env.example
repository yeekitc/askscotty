# Frontend environment.
#
# IMPORTANT: Expo only reads .env from THIS folder (frontend/app/), not from the
# repo root. ./setup.sh creates frontend/app/.env from this file for you.
#
# Only variables starting with EXPO_PUBLIC_ reach the app. They are baked into
# the JavaScript bundle, so never put a secret here.

# Where the Django API lives.
#   iOS Simulator / Android Emulator / web browser -> http://localhost:8000
#   Physical phone -> your laptop's LAN IP, e.g. http://192.168.1.20:8000
#     (on a real phone, "localhost" means the phone itself, not your laptop)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Name shown on the empty-state welcome header ("Ask Scotty, <name>!") until
# there's a real signed-in user (see lib/user.ts). Optional — defaults to a
# placeholder name if unset.
# EXPO_PUBLIC_DEMO_USER_NAME=Yee Kit
