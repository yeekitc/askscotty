# Backend + Docker settings. ./setup.sh copies this to .env for you.
#
# NOTE: this file configures the BACKEND only. The app's settings live in
# frontend/app/.env — Expo does not read this file.

# --- Django ---
DJANGO_SECRET_KEY=dev-only-change-me-askscotty-hackathon
DJANGO_DEBUG=true
# "*" accepts any hostname, which is what makes testing on a physical phone
# (http://<your-laptop-ip>:8000) work. Fine for local development; set a real
# list before deploying anywhere public.
DJANGO_ALLOWED_HOSTS=*

# --- Database ---
# These are read by both Postgres and Django. The database is not exposed to
# your machine by default; see docker-compose.yml if you want a GUI to connect.
POSTGRES_DB=askscotty
POSTGRES_USER=askscotty
POSTGRES_PASSWORD=askscotty

# --- Ports ---
# Change this if something else on your machine already uses port 8000.
# Remember to update EXPO_PUBLIC_API_URL in frontend/app/.env to match.
BACKEND_PORT=8000

# --- External services ---
# The backend starts fine without these. A feature that needs a missing key
# fails with a clear message when you use it, rather than at startup.
#
# Get your own keys — do NOT paste a shared one into the team chat, and never
# commit a real key to this file (it is the *example*; your real values go in
# .env, which is gitignored).

# Planner LLM (Anthropic). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# claude-sonnet-5 is the default. Switch to claude-opus-5 if multi-hop answers
# need more headroom — nothing else has to change.
PLANNER_MODEL=claude-sonnet-5

# How hard the model thinks: low | medium | high | xhigh | max. The main latency
# lever we have, and measured rather than guessed — `low` is ~13% faster end to
# end and ~27% faster to the first token than `medium`, with no loss of tool
# routing (docs/b4-planner.md).
#
# This one is NOT a per-request knob: effort lives on the agent, and an effort
# set on a session is silently ignored. Changing it means re-running
# `manage.py provision_planner`, which mints a new agent version.
PLANNER_EFFORT=low

# Managed Agents config objects. Created once by
# `docker compose exec backend python manage.py provision_planner` — setup.sh
# runs it for you. Not secret, so these values are the real shared ones; re-run
# provisioning only when the system prompt, model or toolset changes.
PLANNER_AGENT_ID=agent_01DdJk8somuLDGETXwgcV3Kf
PLANNER_ENVIRONMENT_ID=env_01FqDU9CZv8N7TfVk1sZZBqy

# What stops a runaway tool loop, in cents. It caps a whole conversation, not one
# question — the session is per thread and the cap is fixed when it opens. A
# 60-second answer costs roughly a tenth of a cent in session time plus its
# tokens, so $5.00 is generous for a demo thread and still bounds a loop. 0
# removes the cap.
PLANNER_SESSION_BUDGET_CENTS=500

# Timeout and retries for the short calls that open a session and send events.
# The event stream is long-lived and sets its own, far higher, ceiling.
PLANNER_REQUEST_TIMEOUT=45
PLANNER_MAX_RETRIES=1

# Ask the model for inline [S1] markers. Leave off until the app can render one
# as a citation chip (tasklist F2) — otherwise a literal "[S1]" shows up in the
# answer text.
PLANNER_CITATION_MARKERS=false

# Level for our own log lines (tool calls, planner cache counters). DEBUG is
# useful when a tool is misbehaving.
LOG_LEVEL=INFO

# Embeddings for the search index (OpenAI). Anthropic has no embeddings
# endpoint, which is why this is a second provider.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector column width in the database. Changing the model means a
# migration and a full re-index, not just editing this line.
EMBEDDING_DIMENSIONS=1536


# Encrypts personal access tokens (Canvas, Ed) before they are stored. Leave
# blank in development and one is derived from DJANGO_SECRET_KEY; required for
# any shared deployment. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=

# How our crawler identifies itself to the sites it indexes. PRD §3 requires
# that we say who we are — leave this alone unless the contact URL changes.
CRAWLER_USER_AGENT=

# --- CORS ---
# Leave blank during development: while DJANGO_DEBUG is true, the API accepts
# requests from any origin, so Expo works on any port or LAN address. Set an
# explicit comma-separated list for a real deployment.
CORS_ALLOWED_ORIGINS=
