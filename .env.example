# Copy to .env (setup.sh does this for you)
DJANGO_SECRET_KEY=dev-only-change-me-askscotty-hackathon
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=askscotty
POSTGRES_USER=askscotty
POSTGRES_PASSWORD=askscotty
POSTGRES_PORT=5432

BACKEND_PORT=8000
WEB_PORT=5173

# Browser / host machine URL used by the Vite web app
VITE_API_URL=http://localhost:8000

# Used by Expo (iOS Simulator can use localhost; physical devices need your laptop IP)
EXPO_PUBLIC_API_URL=http://localhost:8000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
